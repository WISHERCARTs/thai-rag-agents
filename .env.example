# Google Gemini API key (https://aistudio.google.com/apikey). The agents and the evaluation call the API.
GEMINI_API_KEY=your_gemini_api_key_here

# Folder with the saved index built by `python -m thairag ingest` in thai-rag-eval.
# Defaults to ../thai-rag-eval/index
# THAIRAG_INDEX=../thai-rag-eval/index

# Optional: send every model call and query embedding through thai-llm-gateway instead of calling
# Gemini directly (rate limits, budget, PII redaction, injection checks, cost log, traces).
# LLM_GATEWAY_URL=https://thai-llm-gateway-85542351836.asia-southeast1.run.app
# LLM_GATEWAY_KEY=the gateway's client key for thai-rag-agents
